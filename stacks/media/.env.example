PUID=1000
PGID=10
TZ=America/Toronto

CONFIG_DIR=/volume1/docker/media-stack/config
FAMILY_DIR=/volume1/Family
DOWNLOADS_DIR=/volume1/Family/Downloads
MEDIA_DIR=/volume1/Family/Media

SONARR_URL=http://sonarr:8989
SONARR_API_KEY=replace_me

RADARR_URL=http://radarr:7878
RADARR_API_KEY=replace_me

PROFILARR_TAG=latest
PROFILARR_PORT=6868
PROFILARR_SYNC_ON_DEPLOY=0

DISPATCHARR_TAG=latest
DISPATCHARR_PORT=9191

# Dominican Live TV health and guide. The official geo-blocked sources remain
# disabled until a Dominican Tailscale exit node has been configured.
DOMINICAN_EPG_URL=https://epgshare01.online/epgshare01/epg_ripper_DO1.xml.gz
DOMINICAN_IPTV_PROBE_INTERVAL=21600
DOMINICAN_IPTV_PROBE_TIMEOUT=12
DOMINICAN_IPTV_PROBE_WORKERS=10
DOMINICAN_EXIT_NODE_ENABLED=0
# Set these only after the Raspberry Pi in the Dominican Republic is online.
# Keep the auth key in the NAS .env/secrets and never commit it.
DOMINICAN_TAILSCALE_EXIT_NODE=
DOMINICAN_TAILSCALE_AUTHKEY=
