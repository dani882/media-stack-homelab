[Unit]
Description=Verify imported media audio and block proven language mismatches
After=network.target docker.service

[Service]
Type=oneshot
TimeoutStartSec=30min
Nice=15
IOSchedulingClass=idle
ExecCondition=/usr/bin/python3 /volume1/docker/media-stack/check-system-pressure.py --guard
ExecStart=/volume1/docker/media-stack/run-background-task.sh --serialize -- /usr/bin/python3 -u /volume1/docker/media-stack/audit-imported-audio.py --apply
