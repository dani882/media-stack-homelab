[Unit]
Description=Evaluate safe private releases for all monitored Radarr movies
After=network.target docker.service

[Service]
Type=oneshot
TimeoutStartSec=45min
Nice=10
IOSchedulingClass=idle
ExecCondition=/usr/bin/python3 /volume1/docker/media-stack/check-system-pressure.py --guard
# The dispatcher only uses known private indexers and inspects the torrent
# while stopped before allowing any payload to download.
ExecStart=/usr/bin/python3 /volume1/docker/media-stack/dispatch-private-seerr.py --apply
