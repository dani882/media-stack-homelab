[Unit]
Description=Media Stack Live Health Audit
After=network.target docker.service

[Service]
Type=oneshot
TimeoutStartSec=20min
Nice=15
IOSchedulingClass=idle
ExecCondition=/usr/bin/python3 /volume1/docker/media-stack/check-system-pressure.py --guard
ExecStart=/volume1/docker/media-stack/run-background-task.sh --serialize -- /volume1/docker/media-stack/monitor-media-stack.sh
