[Unit]
Description=Dispatch exact Spanish archive releases for marked Radarr movies
After=network.target docker.service

[Service]
Type=oneshot
TimeoutStartSec=45min
Nice=10
IOSchedulingClass=idle
ExecCondition=/usr/bin/python3 /volume1/docker/media-stack/check-system-pressure.py --guard
ExecStart=/usr/bin/python3 /volume1/docker/media-stack/dispatch-archive-spanish.py
