[Unit]
Description=Media Stack Hardlink Audit
After=network.target

[Service]
Type=oneshot
TimeoutStartSec=45min
Nice=15
IOSchedulingClass=idle
ExecCondition=/usr/bin/python3 /volume1/docker/media-stack/check-system-pressure.py --guard
ExecStart=/volume1/docker/media-stack/run-background-task.sh --serialize -- /usr/bin/python3 /volume1/docker/media-stack/audit-hardlinks.py
