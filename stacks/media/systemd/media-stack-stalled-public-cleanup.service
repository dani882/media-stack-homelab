[Unit]
Description=Blocklist stale incomplete public media torrents
After=network.target docker.service

[Service]
Type=oneshot
TimeoutStartSec=30min
Nice=10
IOSchedulingClass=idle
ExecCondition=/usr/bin/python3 /volume1/docker/media-stack/check-system-pressure.py --guard
ExecStart=/usr/bin/python3 -u /volume1/docker/media-stack/cleanup-stalled-public.py --apply --max-delete 10
