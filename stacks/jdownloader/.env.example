# Container release. Update deliberately after reviewing the upstream release.
JDOWNLOADER_TAG=v26.09.1

# Match the owner/group used by the existing media stack on the NAS.
PUID=1000
PGID=10
TZ=America/Toronto

# Web interface. Keep this on the trusted LAN; do not forward it from the router.
JDOWNLOADER_BIND_ADDRESS=0.0.0.0
JDOWNLOADER_WEB_PORT=5800

# Persistent NAS paths.
JDOWNLOADER_CONFIG_DIR=/volume1/docker/jdownloader/config
JDOWNLOADER_DOWNLOADS_DIR=/volume1/Family/Downloads/jdownloader

# Interface and Java memory settings.
DISPLAY_WIDTH=1920
DISPLAY_HEIGHT=1080
DARK_MODE=1
JDOWNLOADER_MAX_MEM=2G
